---
import certImg from '../assets/cert.jpg';
import certImg2 from '../assets/cert-2.jpg';
---

<section class="booking" id="rezerwacja">
    <h2 class="booking-heading">Zarezerwuj wizytę</h2>

  <div class="booking-inner">
    <div class="booking-content">
<div class="booking-left">
  <div class="cert-row">
    <img src={certImg2.src} alt="Certyfikat Jakości ZnanyLekarz 2024" class="cert-img" />
        <img src={certImg.src} alt="Certyfikat Jakości ZnanyLekarz 2025" class="cert-img" />

  </div>
  <a id="zl-url-certificate" class="zl-url" href="https://www.znanylekarz.pl/agnieszka-timorek-lemieszczuk/ginekolog-ginekolog-onkologiczny/siedlce" rel="nofollow" data-zlw-doctor="agnieszka-timorek-lemieszczuk" data-zlw-type="certificate" data-zlw-opinion="false" data-zlw-hide-branding="true" data-zlw-saas-only="true" data-zlw-a11y-title="Widget umówienia wizyty lekarskiej">Agnieszka Timorek-Lemieszczuk - ZnanyLekarz.pl</a>
</div>
      <div class="booking-right">
        <a id="zl-url" class="zl-url" href="https://www.znanylekarz.pl/agnieszka-timorek-lemieszczuk/ginekolog-ginekolog-onkologiczny/siedlce" rel="nofollow" data-zlw-doctor="agnieszka-timorek-lemieszczuk" data-zlw-type="big_with_calendar" data-zlw-opinion="false" data-zlw-hide-branding="true" data-zlw-saas-only="true" data-zlw-a11y-title="Widget umówienia wizyty lekarskiej">Agnieszka Timorek-Lemieszczuk - ZnanyLekarz.pl</a>
      </div>
    </div>
  </div>
</section>

<script src="//platform.docplanner.com/js/widget.js" async></script>

<style>
.booking {
  background: #FAF8F4;
  padding: 80px 48px;
  position: relative;
}

.booking::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160px;
  background: linear-gradient(to bottom, #F0EAE0, #FAF8F4);
  z-index: 0;
}

.booking-inner {
  max-width: 1000px;
  margin: 0 auto;
  padding-left: 48px;
}
.booking-heading {
  font-family: var(--font-body);
  font-size: 11px;
  letter-spacing: 0.2em;
  color: var(--gold);
  text-transform: uppercase;
  margin: 0 0 48px;
  text-align: left;
  position: relative;
  z-index: 1;
}
.booking-content {
  display: grid;
  grid-template-columns: minmax(auto, 380px) 1fr;
  gap: 40px;
  align-items: center;
}

.booking-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  max-width: 300px;
  margin: 0;
}

.booking-right {
  display: flex;
  justify-content: flex-start;
    transform: scale(0.85);
  transform-origin: top left;
}
.cert-img {
  width: 200px;
  margin-top: 24px;
}

@media (max-width: 768px) {
  .booking {
    padding: 60px 24px;
  }

  .booking-content {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .booking-left {
    align-items: center;
    max-width: 100%;
  }

  .booking-right {
    overflow: hidden;
    width: 100%;
  }
}

.cert-row {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}

.cert-img {
  width: 180px;
}


</style>